{
  "name": "notice-note",
  "version": "0.1.0",
  "description": "本地优先的 Markdown 笔记工具：按内容天归档、天级复习提醒与每日回顾",
  "main": "notice_note_client_pc/src/main.js",
  "scripts": {
    "start:pc": "electron --no-deprecation .",
    "start:app": "cd notice_note_client_app && npx cap run android",
    "sync:app": "cd notice_note_client_app && npx cap sync android",
    "open:app": "cd notice_note_client_app && npx cap open android",
    "bundle:pc": "vite build --config vite.editor.config.js",
    "build:pc": "npm run bundle:pc && electron-builder --win nsis --x64",
    "build:app": "cd notice_note_client_app && npx cap sync android && cd android && .\\gradlew.bat copyDebugApkToRelease",
    "build:all": "npm run build:pc && npm run build:app",
    "lint": "node scripts/lint.js && eslint .",
    "lint:syntax": "node scripts/lint.js --syntax-only",
    "test": "node --test tests/*.test.js"
  },
  "keywords": [
    "markdown",
    "note",
    "reminder",
    "electron"
  ],
  "author": "",
  "license": "MIT",
  "build": {
    "appId": "com.notice-note.app",
    "productName": "Notice Note",
    "directories": {
      "output": "release/pc"
    },
    "files": [
      "notice_note_client_pc/**/*",
      "package.json"
    ],
    "afterPack": "scripts/after-pack.js",
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Notice Note Setup ${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Notice Note"
    }
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "gray-matter": "^4.0.3",
    "mammoth": "^1.12.0",
    "word-extractor": "^1.0.4"
  },
  "overrides": {
    "dompurify": "^3.3.4"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@codemirror/commands": "^6.10.0",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.11.3",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.39.8",
    "@lezer/highlight": "^1.2.3",
    "electron": "^42.3.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.39.5",
    "pdfjs-dist": "^6.1.200",
    "vite": "^7.2.7"
  }
}
